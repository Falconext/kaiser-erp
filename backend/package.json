{
  "name": "kaiser-erp-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.2",
  "engines": {
    "node": ">=22 <25",
    "pnpm": "9.12.2"
  },
  "scripts": {
    "build": "prisma generate && prisma db push --accept-data-loss && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "prisma migrate deploy && prisma generate && NINJA_ENV=parentDisabled nest start",
    "start:dev": "lsof -ti:4201 | xargs kill -9 2>/dev/null; prisma db push && prisma generate && NINJA_ENV=parentDisabled nest start --watch",
    "start:debug": "NINJA_ENV=parentDisabled nest start --debug --watch",
    "start:prod": "npx prisma db push --accept-data-loss && npx ts-node prisma/seed.ts && npx ts-node src/scripts/migrate-sedes.ts && node dist/src/main.js",
    "start:railway": "npx prisma db push --accept-data-loss && node dist/src/main.js",
    "sync:plans": "npx ts-node prisma/seeds/update-planes-v2.ts",
    "migrate:sedes": "npx ts-node src/scripts/migrate-sedes.ts",
    "backfill:comision-motivo": "npx ts-node src/scripts/backfill-comision-motivo.ts",
    "reset:stock": "npx ts-node src/scripts/reset-stock-50.ts",
    "import:kaiser": "npx ts-node -r tsconfig-paths/register src/scripts/import-kaiser-catalog.ts",
    "seed:cuentas-kaiser": "npx ts-node -r tsconfig-paths/register src/scripts/seed-cuentas-kaiser.ts",
    "seed:precios-demo": "npx ts-node -r tsconfig-paths/register src/scripts/seed-precios-demo.ts",
    "import:costos": "npx ts-node -r tsconfig-paths/register src/scripts/import-costos-kaiser.ts",
    "fichas:cargar": "node src/scripts/cargar-fichas-tecnicas.mjs",
    "qa:flujo": "npx ts-node -r tsconfig-paths/register src/scripts/qa-flujo-kaiser.ts",
    "qa:maestros": "node src/scripts/qa-maestros.mjs",
    "qa:control-maestros": "node src/scripts/qa-mutacion.mjs",
    "qa:control-permisos": "node src/scripts/qa-permisos-control.mjs",
    "qa:compras": "node src/scripts/qa-compras.mjs",
    "qa:inventario": "node src/scripts/qa-inventario.mjs",
    "qa:traslado-concurrente": "node src/scripts/qa-traslado-concurrente.mjs",
    "qa:produccion": "node src/scripts/qa-produccion.mjs",
    "qa:comercial": "node src/scripts/qa-comercial.mjs",
    "qa:caja": "node src/scripts/qa-caja.mjs",
    "qa:contabilidad": "node src/scripts/qa-contabilidad.mjs",
    "qa:cuadres": "node src/scripts/qa-cuadres.mjs",
    "qa:asientos": "node src/scripts/qa-asientos.mjs",
    "deploy:preflight": "node src/scripts/preflight-deploy.mjs",
    "marcar:nv": "node src/scripts/marcar-nv-importadas.mjs",
    "cuadres:corregir": "node src/scripts/corregir-cuadres.mjs",
    "qa:produccion-concurrente": "node src/scripts/qa-produccion-concurrente.mjs",
    "qa:kardex-concurrente": "node src/scripts/qa-kardex-concurrente.mjs",
    "qa:stock-sin-kardex": "node src/scripts/qa-stock-sin-kardex.mjs",
    "qa:rangos-fecha": "node src/scripts/qa-rangos-fecha.mjs",
    "qa:venta-concurrente": "node src/scripts/qa-venta-concurrente.mjs",
    "qa:concurrencia": "node src/scripts/qa-concurrencia.mjs",
    "qa:permisos-compras": "node src/scripts/qa-permisos-compras.mjs",
    "qa:series": "node src/scripts/qa-series.mjs",
    "qa:sunat-documentos": "node src/scripts/qa-sunat-documentos.mjs",
    "qa:huella": "node src/scripts/qa-huella.mjs",
    "qa:huella-global": "node src/scripts/qa-huella-global.mjs",
    "qa:guia-kardex": "node src/scripts/qa-guia-kardex.mjs",
    "qa:devoluciones": "node src/scripts/qa-devoluciones.mjs",
    "qa:por-llegar": "npx ts-node -r tsconfig-paths/register src/scripts/qa-mercaderia-por-llegar.ts",
    "qa:docs-compra": "node src/scripts/qa-documentos-compra.mjs",
    "qa:trazabilidad": "node src/scripts/qa-trazabilidad.mjs",
    "diagnose:empresa-scope": "npx ts-node src/scripts/diagnose-empresa-scope.ts",
    "seed:digemid": "npx ts-node -r tsconfig-paths/register src/scripts/seed-digemid.ts",
    "postinstall": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "seed:detracciones": "npx ts-node prisma/seeds/seed-detracciones.ts",
    "export:catalog": "npx ts-node scripts/export-catalog-web.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed:computo": "npx ts-node prisma/seeds/seed-computo-products.ts",
    "seed:demo-computo-krezka": "npx ts-node prisma/seeds/seed-demo-computo-krezka.ts",
    "seed:demo-autopartes": "npx ts-node prisma/seeds/seed-demo-autopartes.ts",
    "seed:demo-moda": "npx ts-node prisma/seeds/seed-demo-moda.ts",
    "migracion:plantillas": "npx ts-node -r tsconfig-paths/register src/migracion/generar-plantillas.ts",
    "migracion:validar": "npx ts-node -r tsconfig-paths/register src/migracion/migrar.ts --dry-run",
    "migracion:cargar": "npx ts-node -r tsconfig-paths/register src/migracion/migrar.ts",
    "migracion:revertir": "npx ts-node -r tsconfig-paths/register src/migracion/migrar.ts --revertir",
    "qa:migracion": "node src/scripts/qa-migracion.mjs",
    "qa:todo": "node src/scripts/qa-todo.mjs",
    "qa:exportacion": "node src/scripts/qa-exportacion.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.927.0",
    "@aws-sdk/s3-request-presigner": "^3.927.0",
    "@google/generative-ai": "^0.21.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.8",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/websockets": "^11.1.8",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "archiver": "^8.0.0",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "express": "^4.18.2",
    "fast-xml-parser": "^5.8.0",
    "handlebars": "^4.7.8",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.6",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^24.29.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@prisma/client": "6.17.1",
    "@types/archiver": "^6.0.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "6.17.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "tsconfig-paths": "^4.2.0",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
