<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Comprobante</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: Arial, Helvetica, sans-serif; font-size: 10px; color: #111; }
    .doc { width: 100%; }
    table { border-collapse: collapse; }

    /* ── HEADER ─────────────────────────────────────────────── */
    .header { display: flex; align-items: center; gap: 14px; margin-bottom: 8px; }
    .header .logo { flex-shrink: 0; }
    .header .logo img { object-fit: contain; display: block; }
    .header .empresa { flex: 1; text-align: center; line-height: 1.35; }
    .header .empresa .nombre { font-weight: 700; font-size: 12px; }
    .header .empresa div { font-size: 9px; }
    .header .doc-box {
      flex-shrink: 0; width: 210px; border: 1px solid #111; border-radius: 6px;
      text-align: center; padding: 10px 8px;
    }
    .header .doc-box .ruc { font-weight: 700; font-size: 12px; }
    .header .doc-box .tipo { font-weight: 700; font-size: 13px; margin: 8px 0; }
    .header .doc-box .numero { font-weight: 700; font-size: 12px; border-top: 1px solid #111; padding-top: 6px; }

    /* ── CLIENTE ────────────────────────────────────────────── */
    .cliente-box { border: 1px solid #111; padding: 6px 8px; margin-bottom: 6px; }
    .cliente-box table { width: 100%; }
    .cliente-box td { padding: 1.5px 4px; vertical-align: top; font-size: 9.5px; }
    .cliente-box td.lbl { font-weight: 700; white-space: nowrap; width: 92px; }
    .cliente-box tr.full td { }

    /* ── TABLA PRODUCTOS ────────────────────────────────────── */
    .prod-table { width: 100%; }
    .prod-table thead th {
      background: #6b7280; color: #fff; font-size: 9.5px; font-weight: 700;
      padding: 4px 4px; border: 1px solid #6b7280;
    }
    .prod-table tbody td { padding: 3px 4px; border-left: 1px solid #d1d5db; border-right: 1px solid #d1d5db; font-size: 9.5px; vertical-align: top; }
    .prod-table tbody tr:first-child td { border-top: 1px solid #d1d5db; }
    .p-cod { width: 15%; }
    .p-cant { width: 9%; text-align: right; }
    .p-um { width: 8%; text-align: center; }
    .p-desc { width: 44%; }
    .p-vu { width: 12%; text-align: right; }
    /* Línea sin costo: el V. Unit impreso es referencial y el total va en 0.00. */
    .gratis { font-weight: 700; font-size: 8px; }
    .p-tot { width: 12%; text-align: right; }
    .lote-info { font-size: 8px; color: #555; }

    /* ── BLOQUE INFERIOR (bancos | totales) ─────────────────── */
    .mid { display: flex; margin-top: 6px; gap: 8px; align-items: flex-start; }
    .bancos { flex: 1.15; }
    .bancos table { width: 100%; }
    .bancos th { background: #f3f4f6; border: 1px solid #999; font-size: 8px; font-weight: 700; padding: 2px 4px; text-align: center; }
    .bancos td { border: 1px solid #ccc; font-size: 8px; padding: 2px 4px; }

    .totales { flex: 1; }
    .totales table { width: 100%; }
    .totales td { font-size: 9.5px; padding: 1px 4px; }
    .totales td.lbl { font-weight: 700; }
    .totales td.cur { text-align: right; width: 34px; color: #333; }
    .totales td.val { text-align: right; }

    /* ── FIRMA + IMPORTE TOTAL ──────────────────────────────── */
    .firma-row { display: flex; align-items: center; justify-content: space-between; border-top: 1px solid #111; border-bottom: 1px solid #111; margin-top: 6px; padding: 5px 4px; }
    .firma-row .firma { font-size: 9px; }
    .firma-row .importe { font-weight: 700; font-size: 13px; }
    .firma-row .importe .lbl { font-size: 11px; }

    /* ── SON / OBSERVACIONES / QR ───────────────────────────── */
    .son { font-size: 9.5px; margin-top: 6px; text-transform: uppercase; }
    .foot { display: flex; justify-content: space-between; align-items: flex-start; margin-top: 4px; gap: 12px; }
    .foot .obs { flex: 1; font-size: 9.5px; }
    .foot .obs .t { font-weight: 700; }
    .foot .qr { flex-shrink: 0; text-align: center; }
    .foot .qr img { width: 100px; height: 100px; }

    .legal { text-align: center; font-size: 9px; color: #333; margin-top: 18px; border-top: 1px solid #ccc; padding-top: 8px; }
  </style>
</head>
<body>
<div class="doc">

  <!-- HEADER -->
  <div class="header">
    {{#if logo}}<div class="logo"><img src="{{logo}}" alt="logo" style="width: {{logoSize}}px; height: auto; max-height: {{logoSize}}px;"></div>{{/if}}
    <div class="empresa">
      <div class="nombre">{{nombreComercial}}</div>
      <div>{{direccion}}</div>
      {{#if celular}}<div>Teléfono: {{celular}}</div>{{/if}}
      {{#if email}}<div>Correo: {{email}}</div>{{/if}}
      {{#if emailFacturacion}}<div>Facturación: {{emailFacturacion}}</div>{{/if}}
      {{#if paginaWeb}}<div>WEB: {{paginaWeb}}</div>{{/if}}
    </div>
    <div class="doc-box">
      <div class="ruc">RUC N°{{ruc}}</div>
      <div class="tipo">{{tipoDocumento}} ELECTRÓNICA</div>
      <div class="numero">N° {{serie}}-{{correlativo}}</div>
    </div>
  </div>

  <!-- CLIENTE -->
  <div class="cliente-box">
    <table>
      <tr><td class="lbl">Señor(es)</td><td colspan="5">{{clienteNombre}}</td></tr>
      <tr><td class="lbl">Dirección</td><td colspan="5">{{#if clienteDireccion}}{{clienteDireccion}}{{else}}-{{/if}}</td></tr>
      <tr>
        <td class="lbl">{{clienteTipoDoc}}</td><td>{{clienteNumDoc}}</td>
        <td class="lbl">Cuotas</td><td>{{numCuotas}}</td>
        <td></td><td></td>
      </tr>
      <tr>
        <td class="lbl">F. Emisión</td><td>{{fecha}} {{hora}}</td>
        <td class="lbl">F. Vencimiento</td><td>{{fechaVencimiento}}</td>
        <td class="lbl">Moneda</td><td>{{monedaNombre}}</td>
      </tr>
      <tr>
        <td class="lbl">Condición venta</td><td>{{formaPago}}</td>
        <td class="lbl">Orden Compra</td><td>{{ordenCompra}}</td>
        <td class="lbl">Vendedor</td><td>{{vendedor}}</td>
      </tr>
      <tr>
        <td class="lbl">G. Remisión</td><td>{{guiaRemision}}</td>
        <td class="lbl">Numero Pedido</td><td>{{numeroPedido}}</td>
        <td class="lbl">Referencia</td><td>{{referencia}}</td>
      </tr>
    </table>
  </div>

  <!-- PRODUCTOS -->
  <table class="prod-table">
    <thead>
      <tr>
        <th class="p-cod">COD</th>
        <th class="p-cant">CANT</th>
        <th class="p-um">UM</th>
        <th class="p-desc">DESCRIPCIÓN</th>
        <th class="p-vu">V. Unit</th>
        <th class="p-tot">VENTA TOTAL</th>
      </tr>
    </thead>
    <tbody>
      {{#each productos}}
      <tr>
        <td class="p-cod">{{this.codigo}}</td>
        <td class="p-cant">{{this.cantidad}}</td>
        <td class="p-um">{{this.unidadMedida}}</td>
        <td class="p-desc">
          {{this.descripcion}}{{#if this.gratis}} <span class="gratis">(TRANSFERENCIA GRATUITA)</span>{{/if}}
          {{#if this.lotes}}{{#each this.lotes}}<div class="lote-info">Lote: {{this.lote}} Venc: {{this.fechaVencimiento}}</div>{{/each}}{{/if}}
        </td>
        <td class="p-vu">{{this.precioUnitario}}</td>
        <td class="p-tot">{{this.total}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <!-- BANCOS | TOTALES -->
  <div class="mid">
    <div class="bancos">
      {{#if cuentasBancarias.length}}
      <table>
        <thead>
          <tr><th>Banco</th><th>Moneda</th><th>Cuenta Bancaria</th><th>Código Interbancario (CCI)</th></tr>
        </thead>
        <tbody>
          {{#each cuentasBancarias}}
          <tr><td>{{this.banco}}</td><td>{{this.moneda}}</td><td>{{this.numeroCuenta}}</td><td>{{this.cci}}</td></tr>
          {{/each}}
          {{#if cuentaBancoNacion}}
          <tr><td>Banco de la Nación</td><td>Soles (S/)</td><td>{{cuentaBancoNacion}}</td><td>DETRACCIONES</td></tr>
          {{/if}}
        </tbody>
      </table>
      {{/if}}
    </div>

    <div class="totales">
      <table>
        <tr><td class="lbl">SUBTOTAL</td><td class="cur">{{simboloMoneda}}</td><td class="val">{{subTotal}}</td></tr>
        <tr><td class="lbl">DESCUENTO</td><td class="cur">{{simboloMoneda}}</td><td class="val">{{descuento}}</td></tr>
        <tr><td class="lbl">OP. GRAVADAS</td><td class="cur">{{simboloMoneda}}</td><td class="val">{{mtoOperGravadas}}</td></tr>
        <tr><td class="lbl">OP. GRATUITAS</td><td class="cur">{{simboloMoneda}}</td><td class="val">{{mtoOperGratuitas}}</td></tr>
        <tr><td class="lbl">OP. EXONERADAS</td><td class="cur">{{simboloMoneda}}</td><td class="val">{{mtoOperExoneradas}}</td></tr>
        <tr><td class="lbl">OP. INAFECTA</td><td class="cur">{{simboloMoneda}}</td><td class="val">{{mtoOperInafectas}}</td></tr>
        <tr><td class="lbl">I.S.C</td><td class="cur">{{simboloMoneda}}</td><td class="val">{{isc}}</td></tr>
        <tr><td class="lbl">I.G.V. (18)%</td><td class="cur">{{simboloMoneda}}</td><td class="val">{{mtoIGV}}</td></tr>
      </table>
    </div>
  </div>

  <!-- FIRMA + IMPORTE TOTAL -->
  <div class="firma-row">
    <div class="firma">{{#if hashFirma}}FIRMA DIGITAL: {{hashFirma}}{{/if}}</div>
    <div class="importe"><span class="lbl">IMPORTE TOTAL</span> {{simboloMoneda}} {{mtoImpVenta}}</div>
  </div>

  <!-- SON -->
  <div class="son">SON: {{totalEnLetras}}</div>

  <!-- OBSERVACIONES + QR -->
  <div class="foot">
    <div class="obs">
      <div class="t">Observaciones</div>
      {{#if observaciones}}<div>{{observaciones}}</div>{{/if}}
      {{#if numeroPedidoObs}}<div>N.Pedido: {{numeroPedidoObs}}</div>{{/if}}
    </div>
    {{#if qrCode}}<div class="qr"><img src="{{qrCode}}" alt="QR"></div>{{/if}}
  </div>

  <!-- LEGAL -->
  <div class="legal">
    Representación impresa del comprobante electrónico, consulte en {{sistemaWeb}}
  </div>

</div>
</body>
</html>
