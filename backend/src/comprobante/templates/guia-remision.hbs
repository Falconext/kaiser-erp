<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Guía de Remisión</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            font-size: 11px;
            padding: 20px;
            line-height: 1.3;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 15px;
        }

        .logo-empresa {
            display: flex;
            align-items: flex-start;
            flex: 1;
        }

        .logo-empresa img {
            width: 100px;
            height: 100px;
            margin-right: 15px;
            object-fit: contain;
        }

        .empresa-info h1 {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .empresa-info p {
            font-size: 10px;
            line-height: 1.4;
        }

        .documento {
            border: 1px solid #000;
            padding: 10px 15px;
            text-align: center;
            min-width: 220px;
        }

        .documento .ruc {
            font-size: 12px;
            margin-bottom: 5px;
        }

        .documento .tipo {
            font-size: 16px;
            font-weight: bold;
            margin: 5px 0;
            background-color: #eee;
            padding: 5px 0;
        }

        .documento .numero {
            font-size: 14px;
            margin-top: 5px;
            font-weight: bold;
        }

        .section-title {
            font-weight: bold;
            font-size: 11px;
            background-color: #eee;
            padding: 3px 5px;
            margin-bottom: 5px;
            border: 1px solid #ccc;
        }

        .grid-2 {
            display: flex;
            gap: 10px;
            margin-bottom: 10px;
        }

        .col-half {
            flex: 1;
            border: 1px solid #ccc;
            padding: 5px;
        }

        .label-row {
            display: flex;
            margin-bottom: 3px;
        }

        .label-key {
            font-weight: bold;
            width: 120px;
            min-width: 120px;
        }

        .label-val {
            flex: 1;
        }

        .productos-table {
            width: 100%;
            border: 1px solid #000;
            border-collapse: collapse;
            margin-top: 10px;
        }

        .productos-table th {
            border-bottom: 1px solid #000;
            background-color: #eee;
            padding: 4px;
            font-size: 10px;
            text-align: center;
        }

        .productos-table td {
            padding: 4px;
            font-size: 10px;
            border-right: 1px solid #ccc;
        }

        .productos-table td:last-child {
            border-right: none;
        }

        .footer {
            margin-top: 20px;
            border-top: 1px solid #000;
            padding-top: 10px;
        }

        .qr-section {
            text-align: center;
            margin-top: 10px;
        }

        .qr-img {
            width: 80px;
            height: 80px;
        }
    </style>
</head>

<body>
    <!-- Header -->
    <div class="header">
        <div class="logo-empresa">
            {{#if logo}}
            <img src="{{logo}}" alt="Logo" style="width: {{logoSize}}px; height: {{logoSize}}px;">
            {{/if}}
            <div class="empresa-info">
                <h1>{{nombreComercial}}</h1>
                <p>
                    {{razonSocial}}<br>
                    {{direccion}}<br>
                    {{#if rubro}}{{rubro}}<br>{{/if}}
                    {{#if contacto}}Telf: {{contacto}}<br>{{/if}}
                    {{#if email}}Email: {{email}}{{/if}}
                </p>
            </div>
        </div>
        <div class="documento">
            <div class="ruc">R.U.C. {{ruc}}</div>
            <div class="tipo">GUÍA DE REMISIÓN<br>{{tituloGuia}} ELECTRÓNICA</div>
            <div class="numero">{{serie}}-{{correlativo}}</div>
        </div>
    </div>

    <!-- Fechas y Motivo -->
    <div class="col-half" style="margin-bottom: 10px; border: 1px solid #000;">
        <div class="label-row">
            <div class="label-key">FECHA EMISIÓN:</div>
            <div class="label-val">{{fechaEmision}}</div>
        </div>
        <div class="label-row">
            <div class="label-key">FECHA TRASLADO:</div>
            <div class="label-val">{{fechaTraslado}}</div>
        </div>
        {{#if fechaEntregaBienes}}
        <div class="label-row">
            <div class="label-key">ENTREGA AL TRANSPORTISTA:</div>
            <div class="label-val">{{fechaEntregaBienes}}</div>
        </div>
        {{/if}}
        <div class="label-row">
            <div class="label-key">MOTIVO TRASLADO:</div>
            <div class="label-val">{{motivoTraslado}}</div>
        </div>
        <div class="label-row">
            <div class="label-key">MODALIDAD:</div>
            <div class="label-val">{{modalidadTraslado}}</div>
        </div>
        <div class="label-row">
            <div class="label-key">PESO BRUTO TOTAL:</div>
            <div class="label-val">{{pesoTotal}} {{unidadPeso}}</div>
        </div>
    </div>

    <!-- Puntos de Partida y Llegada -->
    <div class="grid-2">
        <div class="col-half">
            <div class="section-title">PUNTO DE PARTIDA</div>
            <div class="label-row">
                <div class="label-val">{{partidaDireccion}} <br> {{partidaUbigeo}}</div>
            </div>
        </div>
        <div class="col-half">
            <div class="section-title">PUNTO DE LLEGADA</div>
            <div class="label-row">
                <div class="label-val">{{llegadaDireccion}} <br> {{llegadaUbigeo}}</div>
            </div>
        </div>
    </div>

    <!-- Destinatario -->
    <div class="col-half" style="margin-bottom: 10px;">
        <div class="section-title">DATOS DEL DESTINATARIO</div>
        <div class="label-row">
            <div class="label-key">RAZÓN SOCIAL:</div>
            <div class="label-val">{{destinatarioRazonSocial}}</div>
        </div>
        <div class="label-row">
            <div class="label-key">{{#if destinatarioTipoDoc}}{{destinatarioTipoDoc}}{{else}}RUC / DOC{{/if}}:</div>
            <div class="label-val">{{destinatarioNumDoc}}</div>
        </div>
        {{#if esTransportista}}{{#if remitenteBienesRazonSocial}}
        <div class="label-row">
            <div class="label-key">REMITENTE DE LOS BIENES:</div>
            <div class="label-val">{{remitenteBienesRazonSocial}}</div>
        </div>
        <div class="label-row">
            <div class="label-key">DOC. REMITENTE:</div>
            <div class="label-val">{{remitenteBienesNumDoc}}</div>
        </div>
        {{/if}}{{/if}}
    </div>

    <!-- Datos del Transporte -->
    <div class="col-half" style="margin-bottom: 10px;">
        <div class="section-title">DATOS DEL TRANSPORTE</div>

        {{#if esTransportePublico}}
        <div class="label-row">
            <div class="label-key">TRANSPORTISTA:</div>
            <div class="label-val">{{transportistaRazonSocial}}</div>
        </div>
        <div class="label-row">
            <div class="label-key">RUC:</div>
            <div class="label-val">{{transportistaRuc}}</div>
        </div>
        {{#if transportistaMTC}}
        <div class="label-row">
            <div class="label-key">N° REGISTRO MTC:</div>
            <div class="label-val">{{transportistaMTC}}</div>
        </div>
        {{/if}}
        {{/if}}
        {{#if esVehiculoM1oL}}
        <div class="label-row">
            <div class="label-key">TRASLADO:</div>
            <div class="label-val">EN VEHÍCULO DE CATEGORÍA M1 O L</div>
        </div>
        {{/if}}
        {{!-- El vehículo y el conductor NO dependen de la modalidad: en
              transporte público también hay placa y chofer, y es lo que pide el
              fiscalizador en carretera. Antes vivían en el {{else}} de arriba y
              una guía pública los escondía. --}}
        {{#if mostrarVehiculoConductor}}
        <div class="label-row">
            <div class="label-key">VEHÍCULO (PLACA):</div>
            <div class="label-val">{{vehiculoPlaca}}</div>
        </div>
        <div class="label-row">
            <div class="label-key">CONDUCTOR:</div>
            <div class="label-val">{{conductorNombre}}</div>
        </div>
        <div class="label-row">
            <div class="label-key">LICENCIA:</div>
            <div class="label-val">{{conductorLicencia}}</div>
        </div>
        {{#if conductorNumDoc}}
        <div class="label-row">
            <div class="label-key">DOC. CONDUCTOR:</div>
            <div class="label-val">{{conductorNumDoc}}</div>
        </div>
        {{/if}}
        {{/if}}
        {{#if vehiculoAutorizacion}}
        <div class="label-row">
            <div class="label-key">TUCE / HAB. VEH.:</div>
            <div class="label-val">{{vehiculoAutorizacion}}</div>
        </div>
        {{/if}}
        {{#if vehiculoNroAutorizacion}}
        <div class="label-row">
            <div class="label-key">AUT. ESPECIAL:</div>
            <div class="label-val">{{vehiculoNroAutorizacion}}{{#if vehiculoEntidadEmisora}} &middot; {{vehiculoEntidadEmisora}}{{/if}}</div>
        </div>
        {{/if}}
        {{#each vehiculosSecundarios}}
        <div class="label-row">
            <div class="label-key">VEHÍCULO SEC. {{this.orden}}:</div>
            <div class="label-val">{{this.placa}}{{#if this.tuce}} &middot; TUCE {{this.tuce}}{{/if}}</div>
        </div>
        {{/each}}
        {{#each conductoresSecundarios}}
        <div class="label-row">
            <div class="label-key">CONDUCTOR SEC. {{this.orden}}:</div>
            <div class="label-val">{{this.nombre}}{{#if this.numDoc}} &middot; {{this.numDoc}}{{/if}}{{#if this.licencia}} &middot; LIC. {{this.licencia}}{{/if}}</div>
        </div>
        {{/each}}
    </div>

    {{#if documentosRelacionados.length}}
    <div class="col-half" style="margin-bottom: 10px;">
        <div class="section-title">DOCUMENTOS RELACIONADOS</div>
        {{#each documentosRelacionados}}
        <div class="label-row">
            <div class="label-key">{{this.etiqueta}}:</div>
            <div class="label-val">N° {{this.numero}}{{#if this.emisor}} &middot; RUC {{this.emisor}}{{/if}}</div>
        </div>
        {{/each}}
    </div>
    {{/if}}

    {{#if hayIndicadores}}
    <div class="col-half" style="margin-bottom: 10px;">
        <div class="section-title">INDICADORES DEL TRASLADO</div>
        {{#if transbordoProgramado}}
        <div class="label-row">
            <div class="label-key">TRANSBORDO PROGRAMADO:</div>
            <div class="label-val">SÍ</div>
        </div>
        {{/if}}
        {{#if retornoVehiculoVacio}}
        <div class="label-row">
            <div class="label-key">RETORNO DE VEHÍCULO VACÍO:</div>
            <div class="label-val">SÍ</div>
        </div>
        {{/if}}
        {{#if retornoEnvasesVacios}}
        <div class="label-row">
            <div class="label-key">RETORNO CON ENVASES VACÍOS:</div>
            <div class="label-val">SÍ</div>
        </div>
        {{/if}}
        {{#if vehiculoM1oL}}
        <div class="label-row">
            <div class="label-key">VEHÍCULO CATEGORÍA M1 O L:</div>
            <div class="label-val">SÍ</div>
        </div>
        {{/if}}
    </div>
    {{/if}}

    <!-- Items -->
    <table class="productos-table">
        <thead>
            <tr>
                <th style="width: 5%;">ITEM</th>
                <th style="width: 10%;">CODIGO</th>
                <th style="width: 10%;">COD. SUNAT</th>
                <th style="width: 40%;">DESCRIPCION</th>
                <th style="width: 10%;">U.M.</th>
                <th style="width: 10%;">CANT.</th>
            </tr>
        </thead>
        <tbody>
            {{#each detalles}}
            <tr>
                <td style="text-align: center;">{{item}}</td>
                <td style="text-align: center;">{{codigo}}</td>
                <td style="text-align: center;">{{codigoSunat}}</td>
                <td>{{descripcion}}</td>
                <td style="text-align: center;">{{unidad}}</td>
                <td style="text-align: center;">{{cantidad}}</td>
            </tr>
            {{/each}}
        </tbody>
    </table>

    <!-- Footer / Observaciones -->
    <div class="footer">
        {{#if observaciones}}
        <p><strong>OBSERVACIONES:</strong> {{observaciones}}</p>
        {{/if}}
        {{#if usuario}}
        <p style="font-size: 10px;"><strong>EMITIDA POR:</strong> {{usuario}}{{#if fechaImpresion}} &middot; Impresa el {{fechaImpresion}}{{/if}}</p>
        {{/if}}
        <p style="text-align: center; margin-top: 20px; font-size: 10px;">
            Representación impresa de la GUÍA DE REMISIÓN {{tituloGuia}} ELECTRÓNICA<br>
            Este documento ha sido emitido a través de un Proveedor de Servicios Electrónicos autorizado por SUNAT.
        </p>

        {{#if qrCode}}
        <div class="qr-section">
            <img src="{{qrCode}}" alt="QR" class="qr-img">
        </div>
        {{else}}
        {{!-- El QR de la GRE lo entrega SUNAT en el CDR: antes de la aceptación
              no existe, y el hueco en blanco parecía un fallo de impresión. --}}
        <p style="text-align: center; margin-top: 12px; font-size: 10px;">
            El código QR de SUNAT se genera cuando la guía es aceptada.{{#if estadoSunat}} Estado: {{estadoSunat}}.{{/if}}
        </p>
        {{/if}}
    </div>

</body>

</html>